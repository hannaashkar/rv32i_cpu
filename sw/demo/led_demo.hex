// led_demo.hex — the original hardcoded FPGA demo program, preserved as the
// synthesis-default imem contents so the bitstream behaves exactly as before
// the imem rework. Known-broken as a demo: the slli executes as ADD until
// shifts are implemented, so the store never reaches the LED MMIO address
// (BUGLOG B002).
00100093 // addi x1, x0, 1
00400113 // addi x2, x0, 4
01C11113 // slli x2, x2, 28   (executes as ADD today)
001181B3 // add  x3, x3, x1
00312023 // sw   x3, 0(x2)
FE000AE3 // beq  x0, x0, -8
// --- NOP padding to the full 1024-word imem depth (see imem.v: full
// initialization via readmemh avoids relying on initial-loop synthesis). ---
00000013
